# Copy to ".env" (same folder as docker-compose.yml) only if you want to change a default.
# Every value below is optional - the defaults already work for local development.

POSTGRES_DB=reservo
POSTGRES_USER=reservo
POSTGRES_PASSWORD=reservo

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

RABBIT_USER=guest
RABBIT_PASSWORD=guest

# Used by the "full" profile (backend container)
JWT_SECRET=change-me-change-me-change-me-change-me-change-me-1234
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=admin@reservo.local
ADMIN_PASSWORD=Admin@123

# Google OAuth2 (see SETUP.md, section "Google sign-in"). Leave unset to disable the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
